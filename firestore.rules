rules_version = '2';

// Sikkerhetsregler for TPTHK kasserer.
// Publiseres automatisk til Firebase av GitHub Actions når de flettes til main (se docs/regler-automatisk.md).
//
// Kort fortalt:
//  • Bare innloggede med bekreftet e-post, som kassereren har gitt tilgang (en rad i «brukere»), kommer inn.
//  • Kasserere ser og endrer alt.
//  • Medlemmer ser bare sine egne søknader og kvitteringer, sitt eget medlemskort og betalingsinfo.
//  • Alle med tilgang ser møteinnkallinger og referater. Styret (de som har et verv, og kasserere) legger dem ut.
//  • Alle med tilgang ser regelverket (vedtekter o.l.). Styret legger inn, endrer og sletter.
//  • Styret kan lese regnskapet, medlemslisten og søknadene, men ikke endre noe der.
//  • Revisor (revisor: true i «brukere») kan lese regnskapet med kvitteringer, kontoene og medlemslisten,
//    men ikke søknadene eller brukerne (der ligger kontonumre), og kan ikke endre noe. Tilgangen kan ha en
//    sluttdato (revisorTil), som sjekkes mot serverens klokke. Bare kassereren kan gi og fjerne den.
//    En revisor utenfor klubben har rolle «revisor» og ser bare regnskapet, ikke møter, styret eller annet.
//  • Administratoren bestemmer hvilke styreverv som finnes. Kassereren bestemmer hvem som har dem.
//  • Et referat signeres av de styret velger (høyst 8). Når alle har signert, er referatet låst for godt.
//  • Administratoren (admin: true) er vanlig medlem, men får full tilgang i inntil 24 timer
//    når kasserer eller styret ber om support. Tidspunktet sjekkes her, mot serverens klokke.
//    Under support kan administratoren ikke gi noen kasserer-, administrator- eller revisortilgang,
//    og ikke sette seg selv i styret, så tilgangen ikke varer etter at supporten er over.

service cloud.firestore {
  match /databases/{database}/documents {

    function innlogget() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function epost() {
      return request.auth.token.email.lower();
    }
    function profilSti() {
      return /databases/$(database)/documents/brukere/$(epost());
    }
    function profil() {
      return get(profilSti()).data;
    }
    // Vanlig tilgang (medlem, styret, kasserer). En revisor utenfor klubben (rolle «revisor») har det ikke.
    function harTilgang() {
      return innlogget() && exists(profilSti()) && profil().get('rolle', '') != 'revisor';
    }
    // «Ekte» roller, uten support. Bare disse kan be om (og forlenge) support.
    function ekteKasserer() {
      return harTilgang() && profil().rolle == 'kasserer';
    }
    function vervSti() {
      return /databases/$(database)/documents/innstillinger/verv;
    }
    // Styret: de som har et styreverv (lista «styre» i innstillinger/verv), og kasserere.
    function ekteStyret() {
      return harTilgang() && (profil().rolle == 'kasserer'
        || (exists(vervSti()) && epost() in get(vervSti()).data.get('styre', [])));
    }
    function erAdmin() {
      return harTilgang() && profil().get('admin', false) == true;
    }
    function supportSti() {
      return /databases/$(database)/documents/innstillinger/support;
    }
    // Administratoren har full tilgang i 24 timer fra support ble startet, med mindre den er avsluttet.
    function supportAktiv() {
      return harTilgang() && profil().get('admin', false) == true
        && exists(supportSti())
        && get(supportSti()).data.startet + duration.value(24, 'h') > request.time
        && !('avsluttet' in get(supportSti()).data);
    }
    function erKasserer() {
      return ekteKasserer() || supportAktiv();
    }
    function erStyret() {
      return ekteStyret() || supportAktiv();
    }
    // Revisor: lesetilgang til regnskapet, eventuelt med sluttdato.
    function erRevisor() {
      return innlogget() && exists(profilSti()) && profil().get('revisor', false) == true
        && (profil().get('revisorTil', null) == null || profil().get('revisorTil', null) > request.time);
    }
    // De som kan lese regnskapet: kasserer, styret og revisor.
    function seRegnskap() {
      return erStyret() || erRevisor();
    }
    function gyldigBelop(b) {
      return b is int && b > 0 && b < 100000000;
    }
    function tekst(t, maks) {
      return t is string && t.size() <= maks;
    }
    // En brukerprofil som ikke gir mer enn vanlig medlemstilgang.
    function vanligMedlem(d) {
      return d.get('rolle', 'medlem') == 'medlem' && d.get('admin', false) != true && d.get('revisor', false) != true;
    }

    // Hvem som har tilgang, og med hvilken rolle. Dokument-ID er e-postadressen med små bokstaver.
    match /brukere/{e} {
      allow get: if innlogget() && (e == epost() || erKasserer());
      // Under support kan administratoren ikke endre sin egen rolle, og ikke gi andre kasserer-, administrator-
      // eller revisortilgang (som ellers kunne vart etter at supporten er over). Å ta bort slik tilgang går fint.
      allow list: if erKasserer();
      allow delete: if ekteKasserer() || (supportAktiv() && e != epost());
      allow create: if ekteKasserer() || (supportAktiv() && e != epost() && vanligMedlem(request.resource.data));
      allow update: if ekteKasserer()
        || (supportAktiv() && e != epost() && (vanligMedlem(request.resource.data)
            || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['rolle', 'admin', 'revisor', 'revisorTil'])))
        || (harTilgang() && e == epost()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['navn', 'kontonummer']));
    }

    // Personer som har opprettet konto og ber om tilgang.
    match /foresporsler/{e} {
      allow get: if innlogget() && e == epost();
      allow create: if innlogget() && e == epost()
        && request.resource.data.keys().hasOnly(['navn', 'epost', 'tidspunkt'])
        && request.resource.data.epost == epost()
        && request.resource.data.navn is string && request.resource.data.navn.size() > 0 && request.resource.data.navn.size() < 100;
      allow list, delete: if erKasserer();
    }

    // Regnskapet: kassereren fører, styret og revisor leser.
    match /poster/{id} {
      allow read: if seRegnskap();
      allow delete: if erKasserer();
      allow create, update: if erKasserer()
        && request.resource.data.type in ['inntekt', 'utgift', 'overforing']
        && gyldigBelop(request.resource.data.belop)
        && request.resource.data.dato is string;
    }

    match /medlemmer/{id} {
      allow read: if seRegnskap();
      allow write: if erKasserer();
      allow get: if harTilgang() && profil().get('medlemId', '') == id;
    }

    match /innstillinger/klubb {
      allow read: if seRegnskap();
      allow write: if erKasserer();
    }
    // Support: kasserer eller styret gir administratoren full tilgang i inntil 24 timer.
    // Administratoren selv kan lese den og avslutte den tidlig, men ikke starte eller forlenge den.
    match /innstillinger/support {
      allow read: if harTilgang();
      // Starte: tiden settes av serveren, så ingen kan gi lengre tilgang enn 24 timer.
      allow create, update: if
        (ekteStyret() && profil().get('admin', false) != true
          && request.resource.data.keys().hasOnly(['startet', 'startetAv', 'startetAvNavn'])
          && request.resource.data.startet == request.time
          && request.resource.data.startetAv == epost()
          && request.resource.data.get('startetAvNavn', '') is string)
        // Avslutte tidlig.
        || ((ekteStyret() || supportAktiv())
          && resource != null && !('avsluttet' in resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['avsluttet', 'avsluttetAv'])
          && request.resource.data.avsluttet == request.time
          && request.resource.data.avsluttetAv == epost());
    }

    match /innstillinger/medlemsinfo {
      allow read: if harTilgang();
      allow write: if erKasserer();
    }

    // Søknader om refusjon av utlegg.
    match /soknader/{id} {
      allow read: if erStyret() || (harTilgang() && resource.data.epost == epost());
      // Kassereren kan i tillegg legge tilbake søknader fra en sikkerhetskopi.
      // Et medlem fyller bare ut feltene i skjemaet. Resten (behandling, utbetaling) er kassererens.
      allow create: if (harTilgang()
          && request.resource.data.keys().hasOnly(['navn', 'formaal', 'dato', 'belop', 'kontonummer', 'kvitteringIds', 'epost', 'status', 'opprettet'])
          && request.resource.data.epost == epost()
          && request.resource.data.status == 'sendt'
          && gyldigBelop(request.resource.data.belop)
          && tekst(request.resource.data.navn, 100)
          && tekst(request.resource.data.formaal, 500)
          && tekst(request.resource.data.dato, 10)
          && tekst(request.resource.data.kontonummer, 20)
          && request.resource.data.kvitteringIds is list && request.resource.data.kvitteringIds.size() <= 30
          && request.resource.data.opprettet == request.time)
        || (erKasserer() && request.resource.data.epost is string && gyldigBelop(request.resource.data.belop));
      allow update: if erKasserer();
      allow delete: if erKasserer()
        || (harTilgang() && resource.data.epost == epost() && resource.data.status == 'sendt');
    }

    // Kvitteringsbilder. «laast» settes når en søknad er utbetalt, så de ikke kan slettes av medlemmet.
    match /kvitteringer/{id} {
      // Bare bilder (JPEG/PNG) og PDF, og innholdet må være av samme type som kvitteringen sier.
      function gyldigKvittering(d) {
        return d.data is string && d.data.size() < 1000000
          && d.type in ['image/jpeg', 'image/png', 'application/pdf']
          && d.data.matches('data:' + d.type + ';base64,[A-Za-z0-9+/=]+');
      }
      allow read: if seRegnskap() || (harTilgang() && resource.data.eier == epost());
      // Kassereren kan i tillegg legge tilbake kvitteringer fra en sikkerhetskopi.
      allow create: if gyldigKvittering(request.resource.data)
        && ((harTilgang() && request.resource.data.eier == epost()
            && request.resource.data.keys().hasOnly(['navn', 'type', 'data', 'eier', 'lastetOpp'])
            && tekst(request.resource.data.get('navn', ''), 300))
          || erKasserer());
      allow update: if erKasserer();
      allow delete: if erKasserer()
        || (harTilgang() && resource.data.eier == epost() && resource.data.get('laast', false) != true);
    }

    // Styreverv. Alle med tilgang ser hvem som sitter i styret.
    // Administratoren bestemmer hvilke verv som finnes; kassereren bestemmer hvem som har dem.
    // Administratoren kan bare fjerne folk fra styret (når et verv fjernes), aldri legge til. Under support kan
    // administratoren endre alt, men ikke sette seg selv i styret (det ville gitt tilgang etter supporten).
    match /innstillinger/verv {
      function gyldigVerv(d) {
        return d.liste is list && d.tildelt is map && d.styre is list && d.navn is map;
      }
      function ikkeSegSelv(d) {
        return !(epost() in d.styre) || (resource != null && epost() in resource.data.get('styre', []));
      }
      allow read: if harTilgang();
      allow create: if gyldigVerv(request.resource.data) && (ekteKasserer()
        || (supportAktiv() && ikkeSegSelv(request.resource.data))
        || (erAdmin() && request.resource.data.styre.size() == 0));
      allow update: if gyldigVerv(request.resource.data) && (
        (ekteKasserer() && (erAdmin()
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tildelt', 'styre', 'navn', 'endret', 'endretAv'])))
        || (supportAktiv() && ikkeSegSelv(request.resource.data))
        || (erAdmin() && request.resource.data.styre.hasOnly(resource.data.get('styre', []))));
    }

    // Hvem som har innlogging, så styret kan velge hvem som skal signere et referat. Holdes oppdatert av kassereren.
    match /innstillinger/personer {
      allow read: if erStyret() || erAdmin();
      allow write: if erKasserer();
    }

    // Møter: innkalling (alle kan lese) og referat. Referatet ligger her først når det sendes til signering.
    match /moter/{id} {
      function gyldigMote(d) {
        return d.type in ['styremote', 'medlemsmote', 'arsmote'] && d.dato is string && d.tittel is string
          && d.referatStatus in ['ingen', 'utkast', 'signering']
          && (!('signatarer' in d) || (d.signatarer is list && d.signatarer.size() <= 8));
      }
      function signert(e) {
        return existsAfter(/databases/$(database)/documents/signaturer/$(id + '__' + e));
      }
      // Alle på lista har signert (lista har høyst 8 personer, se gyldigMote).
      function alleHarSignert(s) {
        return s.size() <= 8
          && (s.size() < 1 || signert(s[0])) && (s.size() < 2 || signert(s[1]))
          && (s.size() < 3 || signert(s[2])) && (s.size() < 4 || signert(s[3]))
          && (s.size() < 5 || signert(s[4])) && (s.size() < 6 || signert(s[5]))
          && (s.size() < 7 || signert(s[6])) && (s.size() < 8 || signert(s[7]));
      }
      function referatUendret() {
        return request.resource.data.get('referat', null) == resource.data.get('referat', null)
          && request.resource.data.get('referatHash', null) == resource.data.get('referatHash', null)
          && request.resource.data.get('signatarer', []) == resource.data.get('signatarer', []);
      }
      allow read: if harTilgang();
      allow create: if erStyret() && gyldigMote(request.resource.data) && request.resource.data.referatStatus == 'ingen';
      allow delete: if erStyret() && resource.data.referatStatus != 'godkjent';
      allow update: if
        // Den som signerer sist, markerer referatet som godkjent. Da må alle på lista ha signert.
        // (Står først, så sjekken av signaturene ikke kommer i tillegg til oppslagene for styret.)
        (harTilgang() && resource.data.referatStatus == 'signering' && epost() in resource.data.signatarer
          && request.resource.data.referatStatus == 'godkjent'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['referatStatus', 'godkjent'])
          && alleHarSignert(resource.data.signatarer))
        // Styret endrer så lenge referatet ikke er godkjent. Under signering kan ikke teksten endres
        // (da må referatet trekkes tilbake, og signaturene slettes).
        || (erStyret() && resource.data.referatStatus != 'godkjent' && gyldigMote(request.resource.data)
          && (resource.data.referatStatus != 'signering' || request.resource.data.referatStatus != 'signering' || referatUendret()));
    }

    // Regelverk: vedtekter, statutter og andre regler. Alle med tilgang leser, styret legger inn og endrer.
    match /regelverk/{id} {
      function gyldigRegel(d) {
        return d.tittel is string && d.tittel.size() > 0 && d.tittel.size() <= 200
          && d.kategori in ['vedtekter', 'retningslinjer', 'vedtak', 'annet']
          && (!('lenke' in d) || (d.lenke is string && d.lenke.matches('https?://.+')));
      }
      allow read: if harTilgang();
      allow create, update: if erStyret() && gyldigRegel(request.resource.data);
      allow delete: if erStyret();
    }
    // Filene i regelverket (PDF eller Word), delt i biter fordi et dokument kan være maks 1 MB.
    match /regelverkfiler/{id} {
      allow read: if harTilgang();
      allow create, update: if erStyret()
        && request.resource.data.data is string && request.resource.data.data.size() < 1000000;
      allow delete: if erStyret();
    }

    // Referatet mens styret skriver på det. Bare styret ser utkast.
    match /referatutkast/{id} {
      allow read, write: if erStyret();
    }

    // Signaturer på referater. Dokument-ID er «møte-ID__e-post». Hver person signerer bare for seg selv,
    // og bare den teksten som faktisk er sendt til signering (kontrollsummen må stemme).
    match /signaturer/{id} {
      function mote() {
        return get(/databases/$(database)/documents/moter/$(request.resource.data.moteId)).data;
      }
      allow read: if harTilgang();
      allow create: if harTilgang()
        && request.resource.data.keys().hasOnly(['moteId', 'epost', 'navn', 'hash', 'tidspunkt'])
        && request.resource.data.moteId is string
        && id == request.resource.data.moteId + '__' + epost()
        && request.resource.data.epost == epost()
        && request.resource.data.navn is string && request.resource.data.navn.size() < 100
        && request.resource.data.tidspunkt == request.time
        && mote().referatStatus == 'signering'
        && epost() in mote().signatarer
        && request.resource.data.hash == mote().referatHash;
      allow delete: if erStyret()
        && get(/databases/$(database)/documents/moter/$(resource.data.moteId)).data.get('referatStatus', 'slettet') != 'godkjent';
    }
  }
}
