rules_version = '2';

// Sikkerhetsregler for TPTHK kasserer.
// Publiseres automatisk til Firebase av GitHub Actions når de flettes til main (se docs/regler-automatisk.md).
//
// Kort fortalt:
//  • Bare innloggede med bekreftet e-post, som kassereren har gitt tilgang (en rad i «brukere»), kommer inn.
//  • Kasserere ser og endrer alt.
//  • Medlemmer ser bare sine egne søknader og kvitteringer, sitt eget medlemskort og betalingsinfo.
//  • Alle med tilgang ser møteinnkallinger og referater. Styret (de som har et verv, og kasserere) legger dem ut.
//  • Alle med tilgang ser regelverket (vedtekter o.l.). Styret legger inn, endrer og sletter.
//  • Styret kan lese regnskapet, medlemslisten og søknadene, men ikke endre noe der.
//  • Revisor (revisor: true i «brukere») kan lese regnskapet med kvitteringer, kontoene og medlemslisten,
//    men ikke søknadene eller brukerne (der ligger kontonumre), og kan ikke endre noe. Tilgangen kan ha en
//    sluttdato (revisorTil), som sjekkes mot serverens klokke. Bare kassereren kan gi og fjerne den.
//    En revisor utenfor klubben har rolle «revisor» og ser bare regnskapet, ikke møter, styret eller annet.
//  • Administratoren bestemmer hvilke styreverv som finnes. Kassereren bestemmer hvem som har dem.
//  • Et referat signeres av de styret velger (høyst 8). Når alle har signert, er referatet låst for godt.
//  • Administratoren (admin: true) er vanlig medlem, men får full tilgang i inntil 24 timer
//    når kasserer eller styret ber om support. Tidspunktet sjekkes her, mot serverens klokke.
//    Under support kan administratoren ikke gi noen kasserer-, administrator- eller revisortilgang,
//    og ikke sette seg selv i styret, så tilgangen ikke varer etter at supporten er over.
//  • Fôrbestilling: medlemmene bestiller fôr (Royal Canin) i bestillingsrunder. Fôransvarlig (innstillinger/for)
//    ser alle bestillingene og styrer rundene og fôrtypene. Kassereren eller administratoren velger fôransvarlig.
//    Betalingen går ikke via klubben, så bestillingene har ingenting med regnskapet å gjøre.
//  • Støttemedlemmer med rolle «for» (bare fôrbestilling) kan bare bestille fôr og melde seg på fôrordningen.
//    De har ikke vanlig tilgang (harTilgang), så de ser ingen søknader, møter, regelverk eller annet.

service cloud.firestore {
  match /databases/{database}/documents {

    function innlogget() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function epost() {
      return request.auth.token.email.lower();
    }
    function profilSti() {
      return /databases/$(database)/documents/brukere/$(epost());
    }
    function profil() {
      return get(profilSti()).data;
    }
    // Vanlig tilgang (medlem, styret, kasserer). En revisor utenfor klubben (rolle «revisor») og
    // støttemedlemmer som bare kan bestille fôr (rolle «for»), har det ikke.
    function harTilgang() {
      return innlogget() && exists(profilSti()) && !(profil().get('rolle', '') in ['revisor', 'for']);
    }
    // Tilgang til fôrbestillingen: alle med vanlig tilgang, og støttemedlemmer med rolle «for».
    function harForTilgang() {
      return harTilgang() || (innlogget() && exists(profilSti()) && profil().get('rolle', '') == 'for');
    }
    // «Ekte» roller, uten support. Bare disse kan be om (og forlenge) support.
    function ekteKasserer() {
      return harTilgang() && profil().rolle == 'kasserer';
    }
    function vervSti() {
      return /databases/$(database)/documents/innstillinger/verv;
    }
    // Styret: de som har et styreverv (lista «styre» i innstillinger/verv), og kasserere.
    function ekteStyret() {
      return harTilgang() && (profil().rolle == 'kasserer'
        || (exists(vervSti()) && epost() in get(vervSti()).data.get('styre', [])));
    }
    function erAdmin() {
      return harTilgang() && profil().get('admin', false) == true;
    }
    function supportSti() {
      return /databases/$(database)/documents/innstillinger/support;
    }
    // Administratoren har full tilgang i 24 timer fra support ble startet, med mindre den er avsluttet.
    function supportAktiv() {
      return harTilgang() && profil().get('admin', false) == true
        && exists(supportSti())
        && get(supportSti()).data.startet + duration.value(24, 'h') > request.time
        && !('avsluttet' in get(supportSti()).data);
    }
    function erKasserer() {
      return ekteKasserer() || supportAktiv();
    }
    function erStyret() {
      return ekteStyret() || supportAktiv();
    }
    // Revisor: lesetilgang til regnskapet, eventuelt med sluttdato.
    function erRevisor() {
      return innlogget() && exists(profilSti()) && profil().get('revisor', false) == true
        && (profil().get('revisorTil', null) == null || profil().get('revisorTil', null) > request.time);
    }
    // De som kan lese regnskapet: kasserer, styret og revisor.
    function seRegnskap() {
      return erStyret() || erRevisor();
    }
    function forSti() {
      return /databases/$(database)/documents/innstillinger/for;
    }
    function forInnst() {
      return get(forSti()).data;
    }
    // Fôransvarlig: står i lista «ansvarlige» i innstillinger/for. Ser alle fôrbestillingene, men ikke regnskapet.
    function erForansvarlig() {
      return harTilgang() && exists(forSti()) && epost() in forInnst().get('ansvarlige', []);
    }
    function styrerFor() {
      return erForansvarlig() || supportAktiv();
    }
    // Varelinjer i en fôrbestilling: [{ vare, navn, antall }].
    function gyldigeLinjer(l) {
      return l is list && l.size() >= 1 && l.size() <= 20;
    }
    function gyldigBelop(b) {
      return b is int && b > 0 && b < 100000000;
    }
    function tekst(t, maks) {
      return t is string && t.size() <= maks;
    }
    // En brukerprofil som ikke gir mer enn vanlig medlemstilgang.
    function vanligMedlem(d) {
      return d.get('rolle', 'medlem') in ['medlem', 'for'] && d.get('admin', false) != true && d.get('revisor', false) != true;
    }

    // Hvem som har tilgang, og med hvilken rolle. Dokument-ID er e-postadressen med små bokstaver.
    match /brukere/{e} {
      allow get: if innlogget() && (e == epost() || erKasserer());
      // Under support kan administratoren ikke endre sin egen rolle, og ikke gi andre kasserer-, administrator-
      // eller revisortilgang (som ellers kunne vart etter at supporten er over). Å ta bort slik tilgang går fint.
      allow list: if erKasserer();
      allow delete: if ekteKasserer() || (supportAktiv() && e != epost());
      allow create: if ekteKasserer() || (supportAktiv() && e != epost() && vanligMedlem(request.resource.data));
      allow update: if ekteKasserer()
        || (supportAktiv() && e != epost() && (vanligMedlem(request.resource.data)
            || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['rolle', 'admin', 'revisor', 'revisorTil'])))
        || (harForTilgang() && e == epost()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['navn', 'kontonummer']));
    }

    // Personer som har opprettet konto og ber om tilgang.
    match /foresporsler/{e} {
      allow get: if innlogget() && e == epost();
      allow create: if innlogget() && e == epost()
        && request.resource.data.keys().hasOnly(['navn', 'epost', 'tidspunkt'])
        && request.resource.data.epost == epost()
        && request.resource.data.navn is string && request.resource.data.navn.size() > 0 && request.resource.data.navn.size() < 100;
      allow list, delete: if erKasserer();
    }

    // Regnskapet: kassereren fører, styret og revisor leser.
    match /poster/{id} {
      allow read: if seRegnskap();
      allow delete: if erKasserer();
      allow create, update: if erKasserer()
        && request.resource.data.type in ['inntekt', 'utgift', 'overforing']
        && gyldigBelop(request.resource.data.belop)
        && request.resource.data.dato is string;
    }

    match /medlemmer/{id} {
      allow read: if seRegnskap();
      allow write: if erKasserer();
      allow get: if harTilgang() && profil().get('medlemId', '') == id;
    }

    match /innstillinger/klubb {
      allow read: if seRegnskap();
      allow write: if erKasserer();
    }
    // Support: kasserer eller styret gir administratoren full tilgang i inntil 24 timer.
    // Administratoren selv kan lese den og avslutte den tidlig, men ikke starte eller forlenge den.
    match /innstillinger/support {
      allow read: if harTilgang();
      // Starte: tiden settes av serveren, så ingen kan gi lengre tilgang enn 24 timer.
      allow create, update: if
        (ekteStyret() && profil().get('admin', false) != true
          && request.resource.data.keys().hasOnly(['startet', 'startetAv', 'startetAvNavn'])
          && request.resource.data.startet == request.time
          && request.resource.data.startetAv == epost()
          && request.resource.data.get('startetAvNavn', '') is string)
        // Avslutte tidlig.
        || ((ekteStyret() || supportAktiv())
          && resource != null && !('avsluttet' in resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['avsluttet', 'avsluttetAv'])
          && request.resource.data.avsluttet == request.time
          && request.resource.data.avsluttetAv == epost());
    }

    match /innstillinger/medlemsinfo {
      allow read: if harTilgang();
      allow write: if erKasserer();
    }

    // Søknader om refusjon av utlegg.
    match /soknader/{id} {
      allow read: if erStyret() || (harTilgang() && resource.data.epost == epost());
      // Kassereren kan i tillegg legge tilbake søknader fra en sikkerhetskopi.
      // Et medlem fyller bare ut feltene i skjemaet. Resten (behandling, utbetaling) er kassererens.
      allow create: if (harTilgang()
          && request.resource.data.keys().hasOnly(['navn', 'formaal', 'dato', 'belop', 'kontonummer', 'kvitteringIds', 'epost', 'status', 'opprettet', 'linjer', 'bekreftet'])
          && request.resource.data.epost == epost()
          && request.resource.data.status == 'sendt'
          && gyldigBelop(request.resource.data.belop)
          && tekst(request.resource.data.navn, 100)
          && tekst(request.resource.data.formaal, 500)
          && tekst(request.resource.data.dato, 10)
          && tekst(request.resource.data.kontonummer, 20)
          && request.resource.data.kvitteringIds is list && request.resource.data.kvitteringIds.size() <= 30
          // Spesifiseringen (valgfri) og bekreftelsen som er søkerens signatur på regningen.
          && (!('linjer' in request.resource.data) || (request.resource.data.linjer is list && request.resource.data.linjer.size() <= 20))
          && (!('bekreftet' in request.resource.data) || request.resource.data.bekreftet == true)
          && request.resource.data.opprettet == request.time)
        || (erKasserer() && request.resource.data.epost is string && gyldigBelop(request.resource.data.belop));
      allow update: if erKasserer();
      allow delete: if erKasserer()
        || (harTilgang() && resource.data.epost == epost() && resource.data.status == 'sendt');
    }

    // Meldinger til styret. Et medlem ser bare sine egne. Bare de som faktisk sitter i styret (og kasserere) leser alle.
    // Administratoren ser dem ikke, heller ikke under support, fordi medlemmer kan skrive om personlige ting.
    // «meldinger» er saken (emne, status, hvem som har lest), «meldingsinnlegg» er selve tekstene i samtalen.
    function meldingSti(id) {
      return /databases/$(database)/documents/meldinger/$(id);
    }
    function gyldigLestAv(d) {
      return d.lestAv is list && d.lestAv.size() <= 50;
    }
    match /meldinger/{id} {
      allow read: if ekteStyret() || (harTilgang() && resource.data.epost == epost());
      allow create: if harTilgang()
        && request.resource.data.keys().hasOnly(['epost', 'navn', 'emne', 'status', 'opprettet', 'sist', 'sistFra', 'lestAv'])
        && request.resource.data.epost == epost()
        && tekst(request.resource.data.navn, 100)
        && tekst(request.resource.data.emne, 150) && request.resource.data.emne.size() > 0
        && request.resource.data.status == 'apen' && request.resource.data.sistFra == 'medlem'
        && request.resource.data.opprettet == request.time && request.resource.data.sist == request.time
        && request.resource.data.lestAv == [epost()];
      // Styret svarer, merker saken som ferdig og holder styr på hvem som har lest.
      // Medlemmet kan svare (saken åpnes igjen) og merke svaret som lest.
      allow update: if gyldigLestAv(request.resource.data) && (
        (ekteStyret()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'sist', 'sistFra', 'lestAv'])
          && request.resource.data.status in ['apen', 'ferdig'] && request.resource.data.sistFra in ['medlem', 'styret'])
        || (harTilgang() && resource.data.epost == epost()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'sist', 'sistFra', 'lestAv'])
          && (request.resource.data.status == 'apen' || request.resource.data.status == resource.data.status)
          && (request.resource.data.sistFra == 'medlem' || request.resource.data.sistFra == resource.data.sistFra)));
      allow delete: if ekteStyret();
    }
    match /meldingsinnlegg/{id} {
      allow read: if ekteStyret() || (harTilgang() && resource.data.epost == epost());
      // «epost» er alltid medlemmet som eier saken, så medlemmet kan hente alle innleggene i sine egne saker.
      allow create: if request.resource.data.keys().hasOnly(['meldingId', 'epost', 'fra', 'navn', 'tekst', 'tid', 'vedlegg'])
        && request.resource.data.tid == request.time
        && tekst(request.resource.data.navn, 100)
        && tekst(request.resource.data.tekst, 5000) && request.resource.data.tekst.size() > 0
        && request.resource.data.vedlegg is list && request.resource.data.vedlegg.size() <= 5
        && request.resource.data.meldingId is string
        && existsAfter(meldingSti(request.resource.data.meldingId))
        && getAfter(meldingSti(request.resource.data.meldingId)).data.epost == request.resource.data.epost
        && ((request.resource.data.fra == 'medlem' && harTilgang() && request.resource.data.epost == epost())
          || (request.resource.data.fra == 'styret' && ekteStyret()));
      allow delete: if ekteStyret();
    }
    // Vedlegg (bilde eller PDF) til meldinger. Egen samling, så revisor (som leser kvitteringene) ikke ser dem.
    match /meldingsvedlegg/{id} {
      function gyldigVedlegg(d) {
        return d.data is string && d.data.size() < 1000000
          && d.type in ['image/jpeg', 'image/png', 'application/pdf']
          && d.data.matches('data:' + d.type + ';base64,[A-Za-z0-9+/=]+');
      }
      allow get: if ekteStyret() || (harTilgang() && resource.data.epost == epost());
      allow create: if gyldigVedlegg(request.resource.data)
        && request.resource.data.keys().hasOnly(['navn', 'type', 'data', 'epost', 'lastetOpp'])
        && tekst(request.resource.data.navn, 300)
        && request.resource.data.epost is string
        && ((harTilgang() && request.resource.data.epost == epost()) || ekteStyret());
      allow delete: if ekteStyret();
    }

    // E-postvarsel til kassereren om nye søknader, og til fôransvarlig og de påmeldte om fôrbestillingen.
    // Sendes av Firebase-utvidelsen «Trigger Email from Firestore» (se docs/epostvarsel.md), som leser denne samlingen.
    // Bare de faste tekstene kan sendes, og bare til adressene som er valgt (kassereren under Innstillinger,
    // fôransvarlig i innstillinger/for), så samlingen kan ikke brukes til å sende annen e-post.
    // Fôransvarlig kan i tillegg sende de to faste beskjedene om fôrbestillingen til de påmeldte.
    match /mail/{id} {
      function varselEpost() {
        return get(/databases/$(database)/documents/innstillinger/medlemsinfo).data.get('varselEpost', '');
      }
      allow create: if harForTilgang()
        && request.resource.data.message.keys().hasOnly(['subject', 'text'])
        && ((harTilgang() && request.resource.data.keys().hasOnly(['to', 'message']) && varselEpost() != '' && request.resource.data.to == varselEpost()
            && request.resource.data.message.subject == 'Ny søknad om refusjon'
            && request.resource.data.message.text == 'Det har kommet en ny søknad om refusjon av utlegg. Logg inn på https://tpthk.no for å se den.')
          // Ny melding til styret: bare til dem som sitter i styret (som blindkopi). Ingenting fra meldingen står i e-posten.
          || (harTilgang() && request.resource.data.keys().hasOnly(['bcc', 'message'])
            && request.resource.data.bcc is list && request.resource.data.bcc.size() > 0
            && exists(vervSti()) && request.resource.data.bcc.hasOnly(get(vervSti()).data.get('styre', []))
            && request.resource.data.message.subject == 'Ny melding til styret'
            && request.resource.data.message.text == 'Det har kommet en ny melding til styret. Logg inn på https://tpthk.no for å lese den.')
          // Styret har svart: bare til medlemmet som eier saken.
          || (ekteStyret() && request.resource.data.keys().hasOnly(['to', 'message', 'melding'])
            && request.resource.data.melding is string && exists(meldingSti(request.resource.data.melding))
            && request.resource.data.to == get(meldingSti(request.resource.data.melding)).data.epost
            && request.resource.data.message.subject == 'Svar fra styret'
            && request.resource.data.message.text == 'Styret har svart på meldingen din. Logg inn på https://tpthk.no for å lese svaret.')
          // Ny fôrbestilling: bare til fôransvarlig, og bare hvis varselet er slått på.
          || (request.resource.data.keys().hasOnly(['to', 'message']) && exists(forSti()) && forInnst().get('varsel', true) == true
            && forInnst().get('ansvarlige', []).size() > 0 && request.resource.data.to == forInnst().ansvarlige
            && request.resource.data.message.subject == 'Ny fôrbestilling'
            && request.resource.data.message.text == 'Det har kommet en ny bestilling av fôr. Logg inn på https://tpthk.no for å se den.')
          // Fôransvarlig sender beskjed til dem som er påmeldt fôrordningen (som blindkopi, så ingen ser hverandres adresser).
          || (styrerFor() && request.resource.data.keys().hasOnly(['bcc', 'message'])
            && request.resource.data.bcc is list && request.resource.data.bcc.size() > 0 && request.resource.data.bcc.size() <= 300
            && ((request.resource.data.message.subject == 'Fôrbestillingen er åpen'
                && request.resource.data.message.text == 'En ny bestillingsrunde for fôr er åpnet. Logg inn på https://tpthk.no for å bestille, eller for å se over eller endre den faste bestillingen din.')
              || (request.resource.data.message.subject == 'Påminnelse om fôrbestilling'
                && request.resource.data.message.text == 'Husk fôrbestillingen. Runden stenges snart. Logg inn på https://tpthk.no for å bestille.')))
          // Fôransvarlig ber den som har bestilt, om å betale. Bare til den som har bestillingen, og bare med beløp,
          // og navnet og Vipps-nummeret som står i innstillingene for fôrbestilling.
          || (styrerFor() && request.resource.data.keys().hasOnly(['to', 'message', 'forbestilling'])
            && request.resource.data.forbestilling is string
            && exists(/databases/$(database)/documents/forbestillinger/$(request.resource.data.forbestilling))
            && request.resource.data.to == get(/databases/$(database)/documents/forbestillinger/$(request.resource.data.forbestilling)).data.epost
            && forInnst().get('vippsNummer', '') != '' && forInnst().get('vippsNavn', '') != ''
            && request.resource.data.message.subject == 'Betaling for fôrbestilling'
            && request.resource.data.message.text.matches('Hei! Fôret du har bestilt gjennom TPTHK, koster [0-9 ]{1,12},[0-9]{2} kr\\. '
              + 'Vipps beløpet til ' + forInnst().vippsNavn + ' på ' + forInnst().vippsNummer + '\\. '
              + 'Logg inn på https://tpthk\\.no for å se bestillingen\\.')));
      allow read, delete: if erKasserer();
    }

    // Fôrbestilling: fôrtyper, bestillingsrunden og hvem som er fôransvarlig. Alle med tilgang leser.
    // Kassereren eller administratoren velger fôransvarlig. Fôransvarlig endrer resten, men ikke hvem som er fôransvarlig.
    match /innstillinger/for {
      function gyldigFor(d) {
        return d.get('ansvarlige', []) is list && d.get('ansvarlige', []).size() <= 5
          && d.get('navn', {}) is map && d.get('varer', []) is list && d.get('varer', []).size() <= 400
          && tekst(d.get('info', ''), 1000) && d.get('aapen', false) is bool
          // Navn og nummer i betalingsmailen. Bare bokstaver og sifre, så de kan brukes i sjekken av teksten (match /mail).
          && d.get('vippsNavn', '') is string && d.get('vippsNavn', '').matches('[A-Za-zÆØÅæøåÄÖÜäöüÉéÈè -]{0,60}')
          && d.get('vippsNummer', '') is string && d.get('vippsNummer', '').matches('([0-9]{3} [0-9]{2} [0-9]{3})?');
      }
      allow read: if harForTilgang();
      allow create: if (erKasserer() || erAdmin()) && gyldigFor(request.resource.data);
      allow update: if gyldigFor(request.resource.data) && (erKasserer() || erAdmin()
        || (erForansvarlig() && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['ansvarlige', 'navn'])));
    }

    // Fôrbestillinger. Medlemmet bestiller og kan endre eller trekke bestillingen så lenge runden er åpen.
    // Fôransvarlig ser alle, fører pris og om Vippskravet er sendt og betalt, og stenger runden.
    match /forbestillinger/{id} {
      // getAfter: når fôransvarlig åpner en runde, legges de faste bestillingene inn i samme slengen.
      function rundenErAapen(runde) {
        return existsAfter(forSti()) && getAfter(forSti()).data.get('aapen', false) == true
          && runde == getAfter(forSti()).data.get('runde', '');
      }
      function egen() {
        return harForTilgang() && resource.data.epost == epost();
      }
      allow read: if styrerFor() || egen();
      // Fôransvarlig legger inn de faste bestillingene når en runde åpnes (felt «fast»).
      allow create: if (styrerFor()
          && request.resource.data.keys().hasOnly(['navn', 'epost', 'runde', 'linjer', 'kommentar', 'status', 'opprettet', 'fast'])
          && request.resource.data.status == 'ny' && request.resource.data.epost is string
          && gyldigeLinjer(request.resource.data.linjer) && rundenErAapen(request.resource.data.runde))
        || (harForTilgang()
        && request.resource.data.keys().hasOnly(['navn', 'epost', 'runde', 'linjer', 'kommentar', 'status', 'opprettet'])
        && request.resource.data.epost == epost()
        && request.resource.data.status == 'ny'
        && request.resource.data.opprettet == request.time
        && tekst(request.resource.data.navn, 100)
        && tekst(request.resource.data.get('kommentar', ''), 500)
        && gyldigeLinjer(request.resource.data.linjer)
        && rundenErAapen(request.resource.data.runde));
      allow update: if styrerFor()
        || (egen() && resource.data.status == 'ny' && rundenErAapen(resource.data.runde)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['linjer', 'kommentar'])
          && gyldigeLinjer(request.resource.data.linjer)
          && tekst(request.resource.data.get('kommentar', ''), 500));
      allow delete: if styrerFor() || (egen() && resource.data.status == 'ny' && rundenErAapen(resource.data.runde));
    }

    // Påmeldte til fôrordningen. Dokument-ID er e-postadressen. De påmeldte får e-post når en runde åpner,
    // og en eventuell fast bestilling («fast», varelinjer) legges inn av seg selv hver runde.
    match /forabonnenter/{e} {
      allow read: if styrerFor() || (harForTilgang() && e == epost());
      allow create, update: if harForTilgang() && e == epost()
        && request.resource.data.keys().hasOnly(['navn', 'epost', 'fast', 'endret'])
        && request.resource.data.epost == epost()
        && tekst(request.resource.data.navn, 100)
        && (request.resource.data.get('fast', null) == null || gyldigeLinjer(request.resource.data.fast));
      allow delete: if styrerFor() || (harForTilgang() && e == epost());
    }

    // Kvitteringsbilder. «laast» settes når en søknad er utbetalt, så de ikke kan slettes av medlemmet.
    match /kvitteringer/{id} {
      // Bare bilder (JPEG/PNG) og PDF, og innholdet må være av samme type som kvitteringen sier.
      function gyldigKvittering(d) {
        return d.data is string && d.data.size() < 1000000
          && d.type in ['image/jpeg', 'image/png', 'application/pdf']
          && d.data.matches('data:' + d.type + ';base64,[A-Za-z0-9+/=]+');
      }
      allow read: if seRegnskap() || (harTilgang() && resource.data.eier == epost());
      // Kassereren kan i tillegg legge tilbake kvitteringer fra en sikkerhetskopi.
      allow create: if gyldigKvittering(request.resource.data)
        && ((harTilgang() && request.resource.data.eier == epost()
            && request.resource.data.keys().hasOnly(['navn', 'type', 'data', 'eier', 'lastetOpp'])
            && tekst(request.resource.data.get('navn', ''), 300))
          || erKasserer());
      allow update: if erKasserer();
      allow delete: if erKasserer()
        || (harTilgang() && resource.data.eier == epost() && resource.data.get('laast', false) != true);
    }

    // Styreverv. Alle med tilgang ser hvem som sitter i styret.
    // Administratoren bestemmer hvilke verv som finnes; kassereren bestemmer hvem som har dem.
    // Administratoren kan bare fjerne folk fra styret (når et verv fjernes), aldri legge til. Under support kan
    // administratoren endre alt, men ikke sette seg selv i styret (det ville gitt tilgang etter supporten).
    match /innstillinger/verv {
      function gyldigVerv(d) {
        return d.liste is list && d.tildelt is map && d.styre is list && d.navn is map;
      }
      function ikkeSegSelv(d) {
        return !(epost() in d.styre) || (resource != null && epost() in resource.data.get('styre', []));
      }
      allow read: if harTilgang();
      allow create: if gyldigVerv(request.resource.data) && (ekteKasserer()
        || (supportAktiv() && ikkeSegSelv(request.resource.data))
        || (erAdmin() && request.resource.data.styre.size() == 0));
      allow update: if gyldigVerv(request.resource.data) && (
        (ekteKasserer() && (erAdmin()
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tildelt', 'styre', 'navn', 'endret', 'endretAv'])))
        || (supportAktiv() && ikkeSegSelv(request.resource.data))
        || (erAdmin() && request.resource.data.styre.hasOnly(resource.data.get('styre', []))));
    }

    // Hvem som har innlogging, så styret kan velge hvem som skal signere et referat. Holdes oppdatert av kassereren.
    match /innstillinger/personer {
      allow read: if erStyret() || erAdmin();
      allow write: if erKasserer();
    }

    // Møter: innkalling (alle kan lese) og referat. Referatet ligger her først når det sendes til signering.
    match /moter/{id} {
      function gyldigMote(d) {
        return d.type in ['styremote', 'medlemsmote', 'arsmote'] && d.dato is string && d.tittel is string
          && d.referatStatus in ['ingen', 'utkast', 'signering']
          && (!('signatarer' in d) || (d.signatarer is list && d.signatarer.size() <= 8));
      }
      function signert(e) {
        return existsAfter(/databases/$(database)/documents/signaturer/$(id + '__' + e));
      }
      // Alle på lista har signert (lista har høyst 8 personer, se gyldigMote).
      function alleHarSignert(s) {
        return s.size() <= 8
          && (s.size() < 1 || signert(s[0])) && (s.size() < 2 || signert(s[1]))
          && (s.size() < 3 || signert(s[2])) && (s.size() < 4 || signert(s[3]))
          && (s.size() < 5 || signert(s[4])) && (s.size() < 6 || signert(s[5]))
          && (s.size() < 7 || signert(s[6])) && (s.size() < 8 || signert(s[7]));
      }
      function referatUendret() {
        return request.resource.data.get('referat', null) == resource.data.get('referat', null)
          && request.resource.data.get('referatHash', null) == resource.data.get('referatHash', null)
          && request.resource.data.get('signatarer', []) == resource.data.get('signatarer', []);
      }
      allow read: if harTilgang();
      allow create: if erStyret() && gyldigMote(request.resource.data) && request.resource.data.referatStatus == 'ingen';
      allow delete: if erStyret() && resource.data.referatStatus != 'godkjent';
      allow update: if
        // Den som signerer sist, markerer referatet som godkjent. Da må alle på lista ha signert.
        // (Står først, så sjekken av signaturene ikke kommer i tillegg til oppslagene for styret.)
        (harTilgang() && resource.data.referatStatus == 'signering' && epost() in resource.data.signatarer
          && request.resource.data.referatStatus == 'godkjent'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['referatStatus', 'godkjent'])
          && alleHarSignert(resource.data.signatarer))
        // Styret endrer så lenge referatet ikke er godkjent. Under signering kan ikke teksten endres
        // (da må referatet trekkes tilbake, og signaturene slettes).
        || (erStyret() && resource.data.referatStatus != 'godkjent' && gyldigMote(request.resource.data)
          && (resource.data.referatStatus != 'signering' || request.resource.data.referatStatus != 'signering' || referatUendret()));
    }

    // Regelverk: vedtekter, statutter og andre regler. Alle med tilgang leser, styret legger inn og endrer.
    match /regelverk/{id} {
      function gyldigRegel(d) {
        return d.tittel is string && d.tittel.size() > 0 && d.tittel.size() <= 200
          && d.kategori in ['vedtekter', 'retningslinjer', 'vedtak', 'annet']
          && (!('lenke' in d) || (d.lenke is string && d.lenke.matches('https?://.+')));
      }
      allow read: if harTilgang();
      allow create, update: if erStyret() && gyldigRegel(request.resource.data);
      allow delete: if erStyret();
    }
    // Filene i regelverket (PDF eller Word), delt i biter fordi et dokument kan være maks 1 MB.
    match /regelverkfiler/{id} {
      allow read: if harTilgang();
      allow create, update: if erStyret()
        && request.resource.data.data is string && request.resource.data.data.size() < 1000000;
      allow delete: if erStyret();
    }

    // Innkalling og godkjent referat på e-post. Styret ber om utsendelsen her, og skyfunksjonen «sendInnkalling»
    // finner mottakerne selv og sender e-posten (functions/index.js). Bare funksjonen kan endre en utsendelse etterpå.
    // Gamle utsendelser uten «hva» er innkallinger.
    match /utsendelser/{id} {
      allow read: if erStyret();
      allow create: if erStyret()
        && request.resource.data.keys().hasOnly(['moteId', 'hvem', 'hva', 'bestiltAv', 'bestilt', 'status'])
        && request.resource.data.moteId is string
        && exists(/databases/$(database)/documents/moter/$(request.resource.data.moteId))
        && request.resource.data.get('hva', 'innkalling') in ['innkalling', 'referat']
        && (request.resource.data.get('hva', 'innkalling') == 'innkalling'
          || get(/databases/$(database)/documents/moter/$(request.resource.data.moteId)).data.referatStatus == 'godkjent')
        && request.resource.data.hvem in ['styret', 'alle', 'aktive']
        && request.resource.data.bestiltAv == epost()
        && request.resource.data.bestilt == request.time
        && request.resource.data.status == 'venter';
      allow delete: if erStyret();
    }

    // Referatet mens styret skriver på det. Bare styret ser utkast.
    match /referatutkast/{id} {
      allow read, write: if erStyret();
    }

    // Signaturer på referater. Dokument-ID er «møte-ID__e-post». Hver person signerer bare for seg selv,
    // og bare den teksten som faktisk er sendt til signering (kontrollsummen må stemme).
    match /signaturer/{id} {
      function mote() {
        return get(/databases/$(database)/documents/moter/$(request.resource.data.moteId)).data;
      }
      allow read: if harTilgang();
      allow create: if harTilgang()
        && request.resource.data.keys().hasOnly(['moteId', 'epost', 'navn', 'hash', 'tidspunkt'])
        && request.resource.data.moteId is string
        && id == request.resource.data.moteId + '__' + epost()
        && request.resource.data.epost == epost()
        && request.resource.data.navn is string && request.resource.data.navn.size() < 100
        && request.resource.data.tidspunkt == request.time
        && mote().referatStatus == 'signering'
        && epost() in mote().signatarer
        && request.resource.data.hash == mote().referatHash;
      allow delete: if erStyret()
        && get(/databases/$(database)/documents/moter/$(resource.data.moteId)).data.get('referatStatus', 'slettet') != 'godkjent';
    }
  }
}
